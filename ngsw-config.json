{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "start",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/manifest.webmanifest", "/favicon.ico", "/main-*.js", "/styles-*.css", "/polyfills-*.js", "/icons/icon-192.png"]
      }
    },
    {
      "name": "pages",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/*.js", "/*.css"]
      }
    },
    {
      "name": "pictures",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/Images/**", "/icons/**", "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/api/**", "!/uploads/**"]
}
